{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "kyto user events",
    "description": "Tells kyto when its Slack user account is pinged or DMed. Listens only; never posts."
  },
  "oauth_config": {
    "scopes": {
      "user": ["channels:history", "groups:history", "im:history", "mpim:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": ["message.channels", "message.groups", "message.im", "message.mpim"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
